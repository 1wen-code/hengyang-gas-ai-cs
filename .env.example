# ============================================================
#  衡阳燃气AI客服智能体系构建 — 环境变量配置模板
#  使用方法：复制本文件，重命名为 .env，填入真实值即可运行
# ============================================================

# DeepSeek API 密钥（必填）
# 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Flask 调试模式（开发时设为 True，生产环境设为 False）
FLASK_DEBUG=False

# Flask 会话密钥（可选，生产环境建议修改为随机字符串）
SECRET_KEY=

# 管理后台密码（可选，默认 hygas0826）
ADMIN_PASSWORD=
